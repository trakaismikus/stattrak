# RESPAWN TIMER: the wait at the respawn point, in big digits.
#   Right button: start / pause.
#   Left button (paused): back to the full time.
#   Hold left (not while it runs): edit the time, H:MM:SS. In the edit: press right = +1,
#   press left = -1, hold right = next digit, hold left = digit before. The last place is the
#   check mark: a press there saves the time. 10 s without a button saves it too.
#   Time is up: the screen flashes, a chime plays again and again, until you press a button.
#   Choose it in Settings > Background: then it runs on when you go to an other screen, and it
#   comes back on the screen when the time is up (firmware 1.2.0-b3 or newer).

app "RESPAWN TIMER"
version 2
description "The wait at the respawn point in big digits. Start and pause with the right button. Flashes and chimes when you can go."
picture icon runfast "RESPAWN"   # the running man of the GO screen, small, with speed lines
permission sound, awake, background

setting hints "LEFT HINTS" "WORDS" "ICONS"
setting warning "BG WARNING" "ON" "OFF"

bitmap runfast {         # the title picture (also usable in the code)
  "................###..."
  "...............#####.."
  "...............#####.."
  "................###..."
  "...............###...."
  ".####.......######.##."
  "...........##.#######."
  "..........##..####...."
  "#####.........###....."
  "..............###....."
  ".............#####...."
  "............##...##..."
  ".###...#...##.....##.."
  ".......#####.....##..."
  "........###......##..."
  ".................###.."
}

saved total = 600       # the respawn time in seconds (10:00 at the first start)

const READY = 0         # the full time, not started
const RUNNING = 1
const PAUSED = 2
const ALARM = 3

var state = 0
var remain = 0            # milliseconds left (READY, PAUSED)
var end_at = 0          # time() when the time is up (RUNNING)
var ring = 0            # ticks since the time is up (ALARM)
var warn = 0            # 1: the "not in the background" screen shows
var editing = 0
var cursor = 0          # 0 = H, 1 and 2 = minutes, 3 and 4 = seconds, 5 = the check mark
var value = 0           # the time in the edit, in seconds
var last_input = 0
var entry_hold = 0      # 1 = the hold that started the edit (or stopped the alarm) is still down

bitmap go {
  "...........##########................##########..........#######"
  ".........##############............##############........#######"
  ".......#################.........#################.......######."
  "......##################........##################......#######."
  ".....####################......####################.....#######."
  "....#####################.....#####################.....######.."
  "....#####################.....#####################.....######.."
  "...#########.................#########.....########.....######.."
  "...#######...................#######.......########.....#####..."
  "...#######...................#######........#######....######..."
  "..#######...................#######........#######.....######..."
  "..#######...................#######........#######.....#####...."
  "..#######....###########....#######........#######.....#####...."
  ".########....###########...########........#######.....####....."
  ".#######....###########....#######........#######.....#####....."
  ".#######....###########....#######........#######.....#####....."
  ".#######....###########....#######.......########.....####......"
  "#########...##########....#########.....########................"
  "######################....######################................"
  "#####################.....#####################................."
  ".###################.......###################......######......"
  ".###################.......###################......######......"
  "..################..........################.......#######......"
  "...##############............##############........######......."
  "....###########...............###########..........######......."
}

bitmap runner {          # drawn by Mikus in the Screen Designer (designs/respawn-go.json)
  "...................#......"
  ".................#####...."
  "................######...."
  "................#######..."
  "................#######..."
  "................######...."
  "................#####....."
  "...............#####......"
  "...............#####......"
  ".............#######....#."
  ".........##########....###"
  "........############.####."
  ".......#################.."
  "......####..#####.#####..."
  "......###..######...#....."
  "......##..######.........."
  "......#...######.........."
  "..........########........"
  ".........##########......."
  "###.....####...######....."
  "#####..####......####....."
  "##########.......###......"
  "##########......####......"
  "###..###........###......."
  "###.............###......."
  "##.............#####......"
  "...............######....."
  "...............######....."
}

bitmap reset {           # left button: back to the full time
  "..###.#"
  ".#...##"
  "#...###"
  "#......"
  "#.....#"
  ".#...#."
  "..###.."
}

bitmap gear {            # hold the left button: edit the time
  "...#..."
  ".#####."
  ".##.##."
  "##...##"
  ".##.##."
  ".#####."
  "...#..."
}

bitmap check {
  "........#"
  ".......##"
  "#.....##."
  "##...##.."
  ".##.##..."
  "..###...."
  "...#....."
}

on open {
  remain = total * 1000
  if !background() && setting(warning) == 0 { warn = 1 }
}

func sound(freq) { click(freq) }

# Milliseconds left now
func rest() {
  if state == RUNNING { return max(end_at - time(), 0) }
  return remain
}

# --- Edit ---------------------------------------------------------------------------------------

# The digit at place p of `value` (H:MM:SS), and how many values it has (10 or 6)
func digit(p) {
  if p == 0 { return value / 3600 % 10 }
  if p == 1 { return value / 600 % 6 }
  if p == 2 { return value / 60 % 10 }
  if p == 3 { return value % 60 / 10 }
  return value % 10
}
func weight(p) {
  if p == 0 { return 3600 }
  if p == 1 { return 600 }
  if p == 2 { return 60 }
  if p == 3 { return 10 }
  return 1
}

func change(delta) {
  var span = 10
  if cursor == 1 || cursor == 3 { span = 6 }
  var d = digit(cursor)
  value += ((d + delta + span) % span - d) * weight(cursor)
  sound(1000)
}

func start_edit() {
  editing = 1
  cursor = 1
  value = total
  entry_hold = 1
  last_input = time()
  sound(800)
}

func done_edit() {
  editing = 0
  if value > 0 && value != total {
    total = value
    save()
  }
  state = READY
  remain = total * 1000
  sound(1500)
}

# --- Buttons ------------------------------------------------------------------------------------

# A press that only closes a screen (the warning, the alarm): it does nothing more
func closes() {
  if warn {
    warn = 0
    sound(800)
    return 1
  }
  if state == ALARM {
    state = READY
    remain = total * 1000
    sound(800)
    return 1
  }
  return 0
}

func pushed() {
  entry_hold = 0
  if editing { last_input = time() }
}
on down1 { pushed() }
on down2 { pushed() }

on press1 {
  if closes() { return }
  if editing {
    last_input = time()
    if cursor == 5 { done_edit() } else { change(-1) }
  } else if state == PAUSED {
    state = READY
    remain = total * 1000
    sound(600)
  }
}

on press2 {
  if closes() { return }
  if editing {
    last_input = time()
    if cursor == 5 { done_edit() } else { change(1) }
  } else if state == RUNNING {
    remain = rest()
    state = PAUSED
    sound(1000)
  } else {
    end_at = time() + remain
    state = RUNNING
    sound(1500)
  }
}

on long1 {
  if closes() { entry_hold = 1; return }
  if entry_hold { return }
  if editing {
    last_input = time()
    cursor = (cursor + 5) % 6
    sound(800)
  } else if state != RUNNING {
    start_edit()
  }
}

on long2 {
  if closes() { entry_hold = 1; return }
  if entry_hold { return }
  if editing {
    last_input = time()
    cursor = (cursor + 1) % 6
    sound(800)
  }
}

# --- Time ---------------------------------------------------------------------------------------

on tick {
  if editing && time() - last_input > 10000 { done_edit() }
  if state == RUNNING && time() >= end_at {
    state = ALARM
    ring = 0
  }
  if state == ALARM {
    popup()                  # On the screen (the background app), and the screen gets bright
    var k = ring % 16        # A chime of 4 notes, then 1.2 s rest
    if k == 0 { tone(1047, 90) }
    if k == 1 { tone(1319, 90) }
    if k == 2 { tone(1568, 90) }
    if k == 3 { tone(2093, 200) }
    ring += 1
  }
}

# --- Drawing ------------------------------------------------------------------------------------

func colon(x, y, size, gap) {
  fill(x, y, size, size, on)
  fill(x, y + gap, size, size, on)
}

# The time `s` (seconds) from x: MM:SS in scale 4, or H:MM:SS in scale 3 (1 hour or more)
func clock(x, s) {
  if s >= 3600 {
    bignum(x, 5, s / 3600, 1, 3, on)
    colon(x + 19, 11, 2, 6)
    bignum(x + 25, 5, s / 60 % 60, 2, 3, on)
    colon(x + 62, 11, 2, 6)
    bignum(x + 68, 5, s % 60, 2, 3, on)
  } else {
    bignum(x, 2, s / 60, 2, 4, on)
    colon(x + 49, 10, 3, 8)
    bignum(x + 57, 2, s % 60, 2, 4, on)
  }
}

func draw_edit() {
  var p = 0
  while p < 5 {
    var x = 2 + (p + 1) / 2 * 25 + p / 2 * 18     # 2, 27, 45, 70, 88
    var c = on
    if p == cursor {
      fill(x - 2, 4, 19, 23, on)                    # 1 pixel free above and below it
      c = off
      var i = 0
      while i < 3 {
        hline(x + 7 - i, i, 2 * i + 1, on)          # the arrow up
        hline(x + 7 - i, 30 - i, 2 * i + 1, on)     # the arrow down
        i += 1
      }
    }
    bignum(x, 5, digit(p), 1, 3, c)
    p += 1
  }
  colon(21, 11, 2, 6)
  colon(64, 11, 2, 6)
  if cursor == 5 {
    fill(110, 4, 17, 23, on)
    bitmap(114, 12, check, off)
  } else {
    bitmap(114, 12, check, on)
  }
}

func draw_alarm() {
  var c = on
  if (time() / 250) % 2 {
    fill(0, 0, 128, 32, on)
    c = off
  }
  hline(15, 7, 10, c)                 # speed lines
  hline(7, 11, 13, c)
  hline(5, 17, 11, c)
  bitmap(15, 2, runner, c)
  bitmap(48, 3, go, c)
}

func draw_warning() {
  var y = 3                  # A warning triangle
  while y < 29 {
    var half = (y - 3) / 2
    hline(13 - half, y, 2 * half + 1, on)
    y += 1
  }
  fill(12, 11, 3, 9, off)
  fill(12, 22, 3, 3, off)
  text(31, 2, "NOT RUNNING IN", caps, on, left)
  text(31, 9, "THE BACKGROUND", caps, on, left)
  text(31, 18, "SETTINGS >", small, on, left)
  text(31, 25, "BACKGROUND", small, on, left)
  fill(111, 24, 13, 7, on)
  text(117, 25, "OK", small, off, center)
}

on draw {
  if warn { draw_warning(); return }
  if editing { draw_edit(); return }
  if state == ALARM { draw_alarm(); return }

  var ms = rest()
  # The digits; they blink while paused
  if !(state == PAUSED && (time() / 500) % 2) {
    clock(15, (ms + 999) / 1000)
  }

  # Left: the time that is left, as a bar that empties (only after the start)
  if state != READY {
    var h = 12 * ms / max(total * 1000, 1)
    rect(3, 8, 7, 16, on)
    fill(5, 22 - h, 3, h, on)
  }

  # The buttons, only while the time does not run. Left: RST = a short press, SET = hold.
  # Right: start (the play icon).
  if state != RUNNING {
    if setting(hints) == 0 {
      text(7, 1, "RST", small, on, center)
      text(7, 26, "SET", small, on, center)
    } else {
      bitmap(3, 0, reset, on)
      bitmap(3, 25, gear, on)
    }
    var i = 0
    while i < 6 {
      vline(119 + i, 10 + i, 11 - 2 * i, on)
      i += 1
    }
  }
}
