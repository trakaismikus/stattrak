        { "type": "rect", "x": 0, "y": 0, "w": 128, "h": 32, "fill": false, "radius": 3 },
        { "type": "pixels", "x": 8, "y": 9, "rows": [
          "...#####...",
          "..#######..",
          ".#########.",
          ".##..#..##.",
          ".##..#..##.",
          ".#########.",
          "..###.###..",
          "..#######..",
          "..#.#.#.#..",
          "..#######.."
        ], "note": "a small skull" },
        { "type": "text", "x": 72, "y": 4, "text": "KILL STREAK", "font": "big", "align": "center" },
        { "type": "text", "x": 72, "y": 15, "text": "x5", "font": "5x7", "align": "center", "scale": 2, "gap": true, "note": "the count of kills in the streak" }
