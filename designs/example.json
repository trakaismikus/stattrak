        { "type": "text", "x": 64, "y": 1, "text": "TOTAL KILLS", "font": "3x5", "align": "center" },
        { "type": "line", "x1": 20, "y1": 7, "x2": 107, "y2": 7 },
        { "type": "text", "x": 64, "y": 12, "text": "01337", "font": "numbers", "align": "center", "note": "the live total kills value" }
      ]
    },
    {
      "id": "killsDeaths",
      "name": "Kills and deaths",
      "note": "Shows the kills and the deaths of this game side by side. Button 1 adds a kill, button 2 adds a death.",
      "elements": [
        { "type": "text", "x": 32, "y": 2, "text": "KILLS", "font": "5x5", "align": "center" },
        { "type": "text", "x": 96, "y": 2, "text": "DEATHS", "font": "5x5", "align": "center" },
        { "type": "line", "x1": 64, "y1": 2, "x2": 64, "y2": 29 },
        { "type": "text", "x": 32, "y": 12, "text": "23", "font": "5x7", "align": "center", "scale": 2, "gap": false, "note": "the live game kills value" },
        { "type": "text", "x": 96, "y": 12, "text": "7", "font": "5x7", "align": "center", "scale": 2, "gap": false, "note": "the live game deaths value" }
      ]
