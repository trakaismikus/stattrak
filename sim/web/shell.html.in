<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>My SDL App</title>
  <style>
    html, body {
      margin: 0;
      /* padding: 0; */
      background: white;
      width: 100%;
      height: 100%;
      /* overflow: hidden; */

      font-family: "Roboto Condensed", sans-serif;
      font-size: 21.959999px;
      font-style: normal;
      font-weight: 400;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #title-container {
      position: absolute;
      top: 10px;
      text-align: center;
      width: 100%;
      z-index: 10;
      margin: 0;
    }

    /* center the screen */
    #center-wrapper {
      position: absolute;
      inset: 0;                     /* top:0 right:0 bottom:0 left:0 */
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #screen-container {
      position: relative;          /* REQUIRED */
      background-color: black;
      padding: 0;                  /* remove padding for pixel-perfect overlay */
      /* width: 1080px;
      height: 1440px; */
      aspect-ratio: 3/4;              /* your native resolution ratio */
      width: min(90vw, 800px);
      height: auto;
    }

    /* Image + canvas stack */
    #screen-container img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    #screen-container canvas {
      position: absolute;
      top: 40%;
      left: 15%;
      /* width: 47.4%;
      height: 8.88%; */
      width: 61.62%;
      height: 11.84%;
      opacity: 1.0;
    }

    /* Image behind */
    #display-image {
      z-index: 0;
      pointer-events: none;        /* don't block input */
    }

    /* Canvas on top */
    #canvas {
      z-index: 1;
    }

    #instructions {
      position: absolute;
      bottom: 10px;
      text-align: center;
      width: 100%;
      z-index: 10;
      margin: 0;
      font-size: 16px;
      color: #555555;
    }

    /* canvas {
      display: block;
    } */
  </style>
</head>
<body>

  <div id="title-container">
    <h1>StatTrak™ Simulator</h1>
    <div style="margin-top:-20px;">TRIDOS.DESIGN x JZ</div>
  </div>

  <div id="center-wrapper">
    <div id="screen-container">
      <img id="display-image" src="@STATTRAK_IMG_SRC@" alt="">
      <canvas id="canvas"></canvas>
    </div>
  </div>

  <div id="instructions">
    <p>Use left(←) and right(→) arrow keys to navigate</p>
    <p>Version v@PROJECT_VER@</p>
  </div>

  <script>
    var Module = {
      canvas: (function() {
        return document.getElementById('canvas');
      })()
    };
  </script>

  {{{ SCRIPT }}}
</body>
</html>
