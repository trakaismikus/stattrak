<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>StatTrak Simulator</title>
  <style>
    html, body {
      margin: 0;
      /* padding: 0; */
      background: white;
      width: 100%;
      height: 100%;
      /* overflow: hidden; */

      font-family: "Roboto Condensed", sans-serif;
      font-size: 21.959999px;
      font-style: normal;
      font-weight: 400;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #title-container {
      position: absolute;
      top: 10px;
      text-align: center;
      width: 100%;
      z-index: 10;
      margin: 0;
    }

    /* center the screen */
    #center-wrapper {
      position: absolute;
      inset: 0;                     /* top:0 right:0 bottom:0 left:0 */
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #screen-container {
      position: relative;          /* REQUIRED */
      padding: 0;                  /* remove padding for pixel-perfect overlay */
      /* The picture: the front of the 3D model, the device plus 2 mm on each side (63.2 x 34.133 mm),
         the same file as the web updater (updater/assets/device.webp, tools/device_art/README.md) */
      aspect-ratio: 1896 / 1024;
      width: min(90vw, 800px);
      height: auto;
    }

    /* Image + canvas stack */
    #screen-container img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    /* The display: at the place of the real 128 x 32 pixels in the picture (the same numbers as
       .st-dev__screen in updater/css/main.css; updater/tests/device.test.js checks it). Black pixels
       of the canvas let the glass of the picture show through. */
    #screen-container canvas {
      position: absolute;
      left: 11.946%;
      top: 22.969%;
      width: 65.823%;
      height: 30.469%;
      mix-blend-mode: screen;
      image-rendering: pixelated;
    }

    /* Image behind */
    #display-image {
      z-index: 0;
      pointer-events: none;        /* don't block input */
    }

    /* Canvas on top */
    #canvas {
      z-index: 1;
    }

    #instructions {
      position: absolute;
      bottom: 10px;
      text-align: center;
      width: 100%;
      z-index: 10;
      margin: 0;
      font-size: 16px;
      color: #555555;
    }

    /* canvas {
      display: block;
    } */

    /* Apps panel: install an app like the web updater does */
    #apps {
      position: absolute;
      top: 90px;
      right: 16px;
      width: 240px;
      z-index: 20;
      font-size: 15px;
      color: #222222;
      background: #f4f4f4;
      border: 1px solid #dddddd;
      border-radius: 6px;
      padding: 12px;
      box-sizing: border-box;
    }
    #apps h2 { margin: 0 0 8px; font-size: 18px; }
    #apps-list { display: grid; gap: 6px; }
    #apps button.app {
      display: flex; align-items: center; gap: 8px; width: 100%;
      padding: 4px; border: 1px solid #cccccc; border-radius: 4px;
      background: #ffffff; cursor: pointer; font: inherit; text-align: left;
    }
    #apps button.app:hover:not(:disabled) { border-color: #888888; }
    #apps button.app:disabled { opacity: 0.5; cursor: default; }
    #apps button.app canvas {
      position: static; width: 80px; height: 24px; background: #000000; image-rendering: pixelated; flex: none;
    }
    #apps label.file { display: block; margin-top: 8px; font-size: 14px; }
    #apps label.file input { display: block; margin-top: 4px; font-size: 13px; max-width: 100%; }
    #apps label.quick { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 14px; cursor: pointer; }
    #apps-status { margin-top: 10px; min-height: 2.6em; font-size: 14px; color: #444444; }
    #apps-status[data-state="4"] { color: #1a7f37; }
    #apps-status[data-state="5"], #apps-status[data-state="6"] { color: #b42318; }
    #apps-status[data-state="3"] { color: #000000; font-weight: 700; }

    @media (max-width: 900px) {
      #apps { position: static; width: auto; margin: 8px 16px; }
      body { display: block; }
    }
  </style>
</head>
<body>

  <div id="title-container">
    <h1>StatTrak™ Simulator</h1>
    <div style="margin-top:-20px;">TRIDOS.DESIGN x JZ</div>
  </div>

  <div id="center-wrapper">
    <div id="screen-container">
      <img id="display-image" src="@STATTRAK_IMG_SRC@" alt="">
      <canvas id="canvas"></canvas>
    </div>
  </div>

  <div id="apps">
    <h2>Apps</h2>
    <div id="apps-list"></div>
    <label class="file">Other app file (.stapp)
      <input type="file" id="apps-file" accept=".stapp">
    </label>
    <label class="quick"><input type="checkbox" id="apps-open" checked> Answer yes and open the app</label>
    <div id="apps-status" aria-live="polite">Pick an app. It is installed like with the web updater.</div>
  </div>

  <div id="instructions">
    <p>Buttons: left (←) and right (→) arrow keys. Both together: app menu. Hold both: power off / power on.</p>
    <p>Battery voltage: up (↑) / down (↓). Firmware update test: U = send, A = accept.</p>
    <p>Version v@PROJECT_VER@</p>
  </div>

  <script>
    var Module = {
      canvas: (function() {
        return document.getElementById('canvas');
      })()
    };

    // --- Apps panel. The simulator takes Module.simAppPending in its own loop (sim/sdl/main.c) and
    // installs it with the Bluetooth app commands, like the web updater (sim/sdl/sim_apps.c).
    (function() {
      var APPS = @SIM_APPS_JS@;   // updater/apps/*.stapp, as hex text (sim/CMakeLists.txt)
      var BUSY = [1, 2, 3];       // sim_apps_state_t: opening, sending, question
      var list = document.getElementById('apps-list');
      var status = document.getElementById('apps-status');
      var buttons = [];

      function bytes(hex) {
        var out = new Uint8Array(hex.length / 2);
        for (var i = 0; i < out.length; i++) out[i] = parseInt(hex.substr(i * 2, 2), 16);
        return out;
      }
      function name(pkg) {   // header bytes 16..31
        var text = '';
        for (var i = 16; i < 32 && pkg[i]; i++) text += String.fromCharCode(pkg[i]);
        return text;
      }
      function picture(canvas, pkg) {   // 80 x 24 at byte 48: 3 pages of 80 bytes, bit 0 = top
        canvas.width = 80; canvas.height = 24;
        var g = canvas.getContext('2d');
        g.fillStyle = '#000'; g.fillRect(0, 0, 80, 24); g.fillStyle = '#fff';
        for (var x = 0; x < 80; x++)
          for (var y = 0; y < 24; y++)
            if (pkg[48 + (y >> 3) * 80 + x] & (1 << (y & 7))) g.fillRect(x, y, 1, 1);
      }
      var fileInput = document.getElementById('apps-file');
      var openBox = document.getElementById('apps-open');
      function setBusy(busy) {
        buttons.forEach(function(b) { b.disabled = busy; });
        fileInput.disabled = busy;
      }
      function install(pkg, open) {
        status.dataset.state = '1';
        status.textContent = 'Starting...';
        Module.simAppOpen = open;
        Module.simAppPending = pkg;
        setBusy(true);
      }

      APPS.map(bytes).forEach(function(pkg) {
        var button = document.createElement('button');
        button.className = 'app';
        button.type = 'button';
        var pic = document.createElement('canvas');
        picture(pic, pkg);
        var label = document.createElement('span');
        label.textContent = name(pkg);
        button.appendChild(pic);
        button.appendChild(label);
        button.addEventListener('click', function() { button.blur(); install(pkg, openBox.checked); });
        list.appendChild(button);
        buttons.push(button);
      });

      fileInput.addEventListener('change', function(event) {
        var file = event.target.files[0];
        event.target.blur();
        if (!file) return;
        file.arrayBuffer().then(function(data) { install(new Uint8Array(data), openBox.checked); event.target.value = ''; });
      });

      // Start with an app (python tools/app.py sim): simulator.html#app=NAME or #app=<base64url package>,
      // and "&fresh" for a new device (no counters, settings or apps from an earlier visit).
      var hash = new URLSearchParams(location.hash.slice(1));
      // Only this one time: a power-on (a reload of the page) must not install again or forget the device
      try { if (location.hash) history.replaceState(null, '', location.pathname + location.search); } catch (e) { }
      if (hash.has('fresh')) {
        try { localStorage.removeItem('stattrak_sim_state'); } catch (e) { }
      }
      var wanted = hash.get('app');
      if (wanted) {
        var key = wanted.toUpperCase().replace(/[-_]/g, ' ');
        var found = APPS.map(bytes).filter(function(pkg) { return name(pkg) === key; })[0];
        if (!found && wanted.length <= 14) {
          // A name (a package is 48 bytes or more): it is not in this page
          status.dataset.state = '6';
          status.textContent = 'There is no app ' + wanted + ' in this page. Run "python tools/app.py catalog", then build the page again.';
        } else {
          if (!found) {
            try {
              var raw = atob(wanted.replace(/-/g, '+').replace(/_/g, '/'));
              found = new Uint8Array(raw.length);
              for (var i = 0; i < raw.length; i++) found[i] = raw.charCodeAt(i);
            } catch (e) { found = new Uint8Array(0); }
          }
          install(found, true);
        }
      }

      // The buzzer (sim/host/host_board.c): a square wave, a new note replaces the note that plays.
      // A browser plays sound only after a key press or a click on the page.
      var audio = null, note = null;
      Module.simBeep = function(freq, ms) {
        try {
          if (!audio) audio = new (window.AudioContext || window.webkitAudioContext)();
          if (audio.state === 'suspended') audio.resume();
          if (note) { try { note.stop(); } catch (e) { } }
          var osc = audio.createOscillator(), gain = audio.createGain();
          osc.type = 'square';
          osc.frequency.value = freq;
          gain.gain.value = 0.04;
          osc.connect(gain);
          gain.connect(audio.destination);
          osc.start();
          osc.stop(audio.currentTime + Math.max(ms, 15) / 1000);
          note = osc;
        } catch (e) { }
      };

      Module.simAppStatus = function(text, state) {
        status.textContent = text;
        status.dataset.state = String(state);
        setBusy(BUSY.indexOf(state) >= 0);
      };
    })();
  </script>

  {{{ SCRIPT }}}
</body>
</html>
